<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réinitialisation du mot de passe - Growth Capital Academy</title>
    <link rel="stylesheet" href="style.css"> <!-- Assure-toi que ton CSS est bien lié -->
    <style>
        body {
            background-color: #0b0f19;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .auth-card {
            background: #111827;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            width: 100%;
            max-width: 400px;
            border: 1px solid #1f2937;
            text-align: center;
        }
        .logo-container {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 20px;
            text-decoration: none;
        }
        .logo-img {
            height: 40px; /* Ajuste la taille de ton image GCA.png si besoin */
            width: auto;
        }
        .hero-title {
            font-size: 1.2rem;
            font-weight: bold;
            text-align: left;
            line-height: 1.1;
            margin: 0;
        }
        .line-gold { color: #d4af37; display: block; }
        .line-white { color: #ffffff; display: block; }
        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }
        label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.9rem;
            color: #9ca3af;
        }
        input {
            width: 100%;
            padding: 12px;
            border-radius: 6px;
            border: 1px solid #374151;
            background: #1f2937;
            color: #ffffff;
            box-sizing: border-box;
            font-size: 1rem;
        }
        input:focus {
            outline: none;
            border-color: #d4af37;
        }
        .btn-submit {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 6px;
            background: #d4af37;
            color: #0b0f19;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-submit:hover {
            background: #c5a028;
        }
        #message {
            margin-top: 15px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <div class="auth-card">
        <!-- Logo et Titre de la marque -->
        <div class="logo-container">
            <img src="GCA.png" alt="Logo GCA" class="logo-img">
            <h1 class="hero-title">
                <span class="line-gold">GROWTH CAPITAL</span>
                <span class="line-white">ACADEMY</span>
            </h1>
        </div>
        
        <p style="color: #9ca3af; margin-bottom: 25px; font-size: 0.95rem;">Définissez votre nouveau mot de passe</p>

        <form id="reset-form">
            <div class="form-group">
                <label for="new-password">Nouveau mot de passe</label>
                <input type="password" id="new-password" placeholder="••••••••" required minlength="6">
            </div>
            <button type="submit" class="btn-submit" id="submit-btn">Mettre à jour</button>
        </form>

        <div id="message"></div>
    </div>

    <!-- SDK Supabase -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        // Remplace par tes vraies clés Supabase
        const SUPABASE_URL = 'TON_SUPABASE_URL';
        const SUPABASE_ANON_KEY = 'TON_SUPABASE_ANON_KEY';
        const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        const form = document.getElementById('reset-form');
        const messageEl = document.getElementById('message');
        const submitBtn = document.getElementById('submit-btn');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const newPassword = document.getElementById('new-password').value;

            submitBtn.textContent = "Mise à jour...";
            submitBtn.disabled = true;

            // Mise à jour du mot de passe via Supabase (le token est géré automatiquement dans l'URL)
            const { error } = await supabaseClient.auth.updateUser({
                password: newPassword
            });

            if (error) {
                messageEl.style.color = '#ef4444'; // Rouge erreur
                messageEl.textContent = "Erreur : " + error.message;
                submitBtn.textContent = "Mettre à jour";
                submitBtn.disabled = false;
            } else {
                messageEl.style.color = '#10b981'; // Vert succès
                messageEl.textContent = "Mot de passe modifié avec succès ! Redirection...";
                setTimeout(() => {
                    window.location.href = 'dashboard.html';
                }, 2000);
            }
        });
    </script>
</body>
</html>
